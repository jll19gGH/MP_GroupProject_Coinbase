<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".CustomDialogFragmentNoAdd">


    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_marginTop="40dp">

        <ImageView
            android:id="@+id/dialogTickerImage"
            android:layout_width="80dp"
            android:layout_height="70dp"
            android:layout_row="0"
            android:layout_rowSpan="2"
            android:layout_column="0"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:scaleType="fitXY"

            />

        <TextView
            android:id="@+id/dialogCompanyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Company Name"
            android:textColor="@color/black"
            android:textSize="30dp" />

        <TextView
            android:id="@+id/dialogTickerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Ticker"
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_marginTop="30dp">

        <TextView
            android:id="@+id/dialogPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Price: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_marginTop="20dp">


        <TextView
            android:id="@+id/dialogChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Price Change: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="4"
        android:layout_column="0"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/dialogChangesPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Change Percentage: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="5"
        android:layout_column="0"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/dialogDayHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Day High: "
            android:textColor="@color/black"
            android:textSize="20dp" />


    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="6"
        android:layout_column="0"
        android:layout_marginTop="20dp">


        <TextView
            android:id="@+id/dialogDayLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Day Low: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="7"
        android:layout_column="0"
        android:layout_marginTop="20dp">


        <TextView
            android:id="@+id/dialogYearHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Year High: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="8"
        android:layout_column="0"
        android:layout_marginTop="20dp">


        <TextView
            android:id="@+id/dialogYearLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Year Low: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="9"
        android:layout_column="0"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/dialogMktCap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Market Capitalization: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="10"
        android:layout_column="0"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/dialogVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Volume: "
            android:textColor="@color/black"
            android:textSize="20dp" />


    </GridLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_row="11"
        android:layout_column="0"
        android:layout_marginTop="20dp">


        <TextView
            android:id="@+id/dialogAvgVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="left"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/corben"
            android:text="Average Volume: "
            android:textColor="@color/black"
            android:textSize="20dp" />

    </GridLayout>




</GridLayout>